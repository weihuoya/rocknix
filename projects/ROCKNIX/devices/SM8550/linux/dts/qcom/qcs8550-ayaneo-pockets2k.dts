/dts-v1/;

#include "qcs8550-ayaneo-pocket-common.dtsi"
#include "qcs8550-sdhc2-downstream.dtsi"

/ {
	model = "AYANEO Pocket S 2K";
	compatible = "ayaneo,pocket-s1", "qcom,sm8550";
	chassis-type = "handset";

	/*
	 * AYA SPACE, =, LC, RC and Standard are on SoC GPIOs, not the
	 * controller MCU. Keep this separate from the common gpio-keys node
	 * so InputPlumber does not grab volume.
	 */
	aya-keys {
		compatible = "gpio-keys";
		label = "aya-keys";

		pinctrl-0 = <&aya_keys_default>;
		pinctrl-names = "default";

		key-aya-space {
			label = "AYA Space";
			debounce-interval = <15>;
			gpios = <&tlmm 85 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_A>;
			wakeup-source;
		};

		key-menu {
			label = "Menu";
			debounce-interval = <15>;
			gpios = <&tlmm 169 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_EQUAL>;
			wakeup-source;
		};

		key-lc {
			label = "LC";
			debounce-interval = <15>;
			gpios = <&tlmm 91 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_LEFT>;
			wakeup-source;
		};

		key-rc {
			label = "RC";
			debounce-interval = <15>;
			gpios = <&tlmm 88 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_RIGHT>;
			wakeup-source;
		};

		/* The 2K wires RC to GPIO170; keep GPIO88 as the stock DT's alternate and report both as KEY_RIGHT. */
		key-rc2 {
			label = "RC";
			debounce-interval = <15>;
			gpios = <&tlmm 170 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_RIGHT>;
			wakeup-source;
		};

		key-standard {
			label = "Standard";
			debounce-interval = <15>;
			gpios = <&tlmm 109 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_YELLOW>;
			wakeup-source;
		};
	};
};

/* Physical + is on the PMIC resin input, - on the PM8550 GPIO. */
&{/gpio-keys/key-volume-up} {
	label = "Volume Down";
	linux,code = <KEY_VOLUMEDOWN>;
};

&pon_resin {
	linux,code = <KEY_VOLUMEUP>;
};

&tlmm {
	aya_keys_default: aya-keys-default-state {
		pins = "gpio85", "gpio88", "gpio91", "gpio109", "gpio169", "gpio170";
		function = "gpio";
		drive-strength = <2>;
		bias-pull-up;
	};

	panel_pwr_active: panel-pwr-active-state {
		pins = "gpio72", "gpio42", "gpio152", "gpio153";
		function = "gpio";
		drive-strength = <8>;
		bias-disable;
		output-high;
	};

	panel_pwr_sleep: panel-pwr-sleep-state {
		pins = "gpio72", "gpio42", "gpio152", "gpio153";
		function = "gpio";
		output-low;
	};

	backlight_pwr_active: backlight-pwr-active-state {
		pins = "gpio41";
		function = "gpio";
		drive-strength = <8>;
		bias-disable;
		output-high;
	};

	backlight_pwr_sleep: backlight-pwr-sleep-state {
		pins = "gpio41";
		function = "gpio";
		output-low;
	};

	ts_irq: ts-irq-state {
		pins = "gpio25";
		function = "gpio";
		drive-strength = <8>;
		bias-pull-up;
		input-enable;
	};

	ts_reset: ts-reset-state {
		pins = "gpio24";
		function = "gpio";
		drive-strength = <8>;
		bias-disable;
		output-high;
	};
};

&i2c0 {
   clock-frequency = <400000>;
	status = "okay";

	/* Screen power */
	regulator@3e {
		compatible = "sgmicro,sgm3804";
		reg = <0x3e>;
		pinctrl-0 = <&panel_pwr_active>;
		pinctrl-1 = <&panel_pwr_sleep>;
		pinctrl-names = "default", "sleep";

		vin-supply = <&vph_pwr>;

		sgm3804_pos: pos {
			regulator-name = "panel-avdd";
			regulator-min-microvolt = <5200000>;
			regulator-max-microvolt = <5200000>;
			regulator-active-discharge = <1>;
			regulator-boot-on;
			enable-gpios = <&tlmm 152 GPIO_ACTIVE_HIGH>;
		};

		sgm3804_neg: neg {
			regulator-name = "panel-avee";
			regulator-min-microvolt = <5200000>;
			regulator-max-microvolt = <5200000>;
			regulator-active-discharge = <1>;
			regulator-boot-on;
			enable-gpios = <&tlmm 153 GPIO_ACTIVE_HIGH>;
		};
	};

	/* Backlight */
	backlight: sy7758@2e {
		compatible = "silergy,sy7758";
		reg = <0x2e>;
		enable-gpios = <&tlmm 41 GPIO_ACTIVE_HIGH>;
		pinctrl-0 = <&backlight_pwr_active>;
		pinctrl-1 = <&backlight_pwr_sleep>;
		pinctrl-names = "default", "sleep";
		status = "okay";
	};
};

&i2c4 {
	status = "okay";
	clock-frequency = <400000>;

	touchscreen@5d {
		reg = <0x5d>;
		status = "okay";
		compatible = "goodix,gt911";

		interrupt-parent = <&tlmm>;
		interrupts = <25 IRQ_TYPE_EDGE_FALLING>;

		irq-gpios = <&tlmm 25 GPIO_ACTIVE_HIGH>;
		/* goodix.c drives reset as logical 0=assert/1=release; keep logical == physical */
		reset-gpios = <&tlmm 24 GPIO_ACTIVE_HIGH>;
		VDDIO-supply = <&vreg_l14b_3p2>;
		AVDD28-supply = <&vreg_l14b_3p2>;

		touchscreen-size-x = <1440>;
		touchscreen-size-y = <2560>;

		pinctrl-names = "default";
		pinctrl-0 = <&ts_reset>, <&ts_irq>;
	};
};

/* wt0600 60hz 2k dual dsi dphy panel */
&mdss_dsi0 {
	qcom,master-dsi;
	qcom,dual-dsi-mode;
	qcom,sync-dual-dsi;
};

&mdss_dsi0_out {
	remote-endpoint = <&panel0_in_0>;
	data-lanes = <0 1 2 3>;
};

&mdss_dsi0_phy {
	vdds-supply = <&vreg_l1e_0p88>;
	status = "okay";
};

&mdss_dsi1 {
	vdda-supply = <&vreg_l3e_1p2>;
	qcom,dual-dsi-mode;
	qcom,sync-dual-dsi;
	assigned-clock-parents = <&mdss_dsi0_phy DSI_BYTE_PLL_CLK>, <&mdss_dsi0_phy DSI_PIXEL_PLL_CLK>;
	status = "okay";
};

&mdss_dsi1_out {
	remote-endpoint = <&panel0_in_1>;
	data-lanes = <0 1 2 3>;
};

&mdss_dsi1_phy {
	vdds-supply = <&vreg_l1e_0p88>;
	status = "okay";
};

&display_panel {
	status = "okay";
	compatible = "ayaneo,wt0600-2k";

	avdd-supply = <&sgm3804_pos>;
	avee-supply = <&sgm3804_neg>;

	reset-gpios = <&tlmm 133 GPIO_ACTIVE_LOW>;
	backlight = <&backlight>;
	rotation = <90>;

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;
			panel0_in_0: endpoint {
				remote-endpoint = <&mdss_dsi0_out>;
			};
		};

		port@1{
			reg = <1>;
			panel0_in_1: endpoint {
				remote-endpoint = <&mdss_dsi1_out>;
			};
		};
	};
};
