+/*
+ * 把用户态已分配的 dma-buf(fd 传入)包装成 fastrpc_buf,用于
+ * flags=0 的 mmap 请求(下游 adsprpc 的常规路径,libcdsprpc 的
+ * apps_mem/rpcmem 依赖它):attach 进会话的 SMMU domain 取 iova,
+ * 后续 INIT_MMAP 把该地址告诉 DSP。
+ */
+static int fastrpc_buf_wrap_dmabuf(struct fastrpc_user *fl, struct device *dev,
+				   int fd, u64 size, struct fastrpc_buf **obuf)
+{
+	struct fastrpc_buf *buf;
+	struct scatterlist *sgl;
+	struct sg_table *sgt;
+	u64 total = 0;
+	int err, i;
+
+	buf = kzalloc_obj(*buf);
+	if (!buf)
+		return -ENOMEM;
+
+	INIT_LIST_HEAD(&buf->attachments);
+	INIT_LIST_HEAD(&buf->node);
+	mutex_init(&buf->lock);
+	buf->fl = fl;
+	buf->virt = NULL;
+	buf->dma_addr = 0;
+	buf->size = size;
+	buf->dev = dev;
+	buf->raddr = 0;
+	buf->attach = NULL;
+	buf->sgt = NULL;
+
+	buf->dmabuf = dma_buf_get(fd);
+	if (IS_ERR(buf->dmabuf)) {
+		err = PTR_ERR(buf->dmabuf);
+		goto err_free;
+	}
+
+	buf->attach = dma_buf_attach(buf->dmabuf, dev);
+	if (IS_ERR(buf->attach)) {
+		err = PTR_ERR(buf->attach);
+		goto err_put;
+	}
+
+	sgt = dma_buf_map_attachment_unlocked(buf->attach, DMA_BIDIRECTIONAL);
+	if (IS_ERR(sgt)) {
+		err = PTR_ERR(sgt);
+		goto err_detach;
+	}
+	buf->sgt = sgt;
+
+	for_each_sg(sgt->sgl, sgl, sgt->nents, i)
+		total += sg_dma_len(sgl);
+	if (size > total) {
+		dev_err(dev, "wrap dmabuf: size 0x%llx over mapping 0x%llx\n",
+			size, total);
+		err = -EINVAL;
+		goto err_unmap;
+	}
+
+	buf->dma_addr = fastrpc_compute_dma_addr(fl, sg_dma_address(sgt->sgl));
+
+	*obuf = buf;
+
+	return 0;
+
+err_unmap:
+	dma_buf_unmap_attachment_unlocked(buf->attach, sgt, DMA_BIDIRECTIONAL);
+err_detach:
+	dma_buf_detach(buf->dmabuf, buf->attach);
+err_put:
+	dma_buf_put(buf->dmabuf);
+err_free:
+	mutex_destroy(&buf->lock);
+	kfree(buf);
+	return err;
+}
